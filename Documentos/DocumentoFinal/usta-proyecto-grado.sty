  personales y únicamente se vea el anhelo de buscar la verdad científica.
  \clearpage}

% -------------------------------------------- sección de preliminares ---
% Título de primer nivel SIN numerar y que sí entra en el índice.
\newcommand{\ustaseccion}[1]{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{chapter}{#1}%
  {\centering\bfseries\large\MakeUppercase{#1}\par}
  \vspace{1em}}

\endinput
