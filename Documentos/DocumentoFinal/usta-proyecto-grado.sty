% =====================================================================
%  usta-proyecto-grado.sty
%  Formato del documento final de proyecto de grado, Universidad Santo Tomás,
%  Facultad de Ingeniería Electrónica.
%
%  Derivado de PlantillaProyectoGrado.docx (recibida el 2026-09-28).
%
%  QUÉ NORMA SE SIGUE, Y POR QUÉ HUBO QUE ELEGIR
%  ---------------------------------------------
%  La plantilla .docx se contradice a sí misma. Su propio texto, en la sección
%  DESARROLLO, declara:
%
%     «construida a partir de la NTC 1486 de ICONTEC con vigencia 2022 [...]
%      Tipo de letra (Arial o Times New Roman, 12 pts), márgenes (3 cm superior
%      e izquierdo, 2 cm inferior y derecho), interlineado (1.5)»
%
%  pero el archivo venía configurado con márgenes 3/3/4/2 cm, letra de 11 pt e
%  interlineado 1,08 — que son, literalmente, los valores por omisión de Word.
%
%  SE SIGUE EL TEXTO NORMATIVO, no la configuración del archivo, porque es el
%  que cita la norma y el que un jurado puede verificar. La decisión se deja
%  escrita aquí para que sea visible y revisable, no enterrada en un valor.
%
%  Si la facultad exige los 4 cm de margen izquierdo para encuadernación,
%  cambiar 'left=3cm' por 'left=4cm' abajo y anotarlo.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{usta-proyecto-grado}[2026/09/28 Formato NTC 1486 USTA]

% ------------------------------------------------------- idioma y fuentes ---
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[spanish,es-tabla,es-nodecimaldot]{babel}
\RequirePackage{mathptmx}          % Times New Roman, una de las dos que admite la norma
\RequirePackage{microtype}

% ------------------------------------------------------------- geometría ---
% NTC 1486: 3 cm superior e izquierdo, 2 cm inferior y derecho. Papel carta.
\RequirePackage[letterpaper,top=3cm,left=3cm,bottom=2cm,right=2cm]{geometry}

% --------------------------------------------------------- interlineado ---
\RequirePackage{setspace}
\onehalfspacing                     % 1,5 según la norma

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.8em}

% ------------------------------------------------------------- utilidades ---
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{amsmath,amssymb}
\RequirePackage{siunitx}
\sisetup{output-decimal-marker={,}} % coma decimal, como el resto del proyecto

% ------------------------------------------------------------- títulos ---
% La plantilla usa mayúsculas sostenidas en los títulos de primer nivel.
\RequirePackage{titlesec}
\titleformat{\chapter}[hang]
  {\normalfont\bfseries\Large\MakeUppercase}{\thechapter.}{1em}{}
\titlespacing*{\chapter}{0pt}{0pt}{1.5em}
\titleformat{\section}[hang]
  {\normalfont\bfseries\large}{\thesection}{1em}{}
\titleformat{\subsection}[hang]
  {\normalfont\bfseries\normalsize}{\thesubsection}{1em}{}

% --------------------------------------------- figuras, tablas y leyendas ---
\RequirePackage[font=small,labelfont=bf,labelsep=period]{caption}

% La plantilla distingue FIGURAS de GRÁFICAS y pide una lista para cada una.
% Su nota aclaratoria: «una gráfica contiene ejes coordenados para expresar
% comportamiento de datos»; la figura representa objetos o conceptos.
\newfloat{grafica}{htbp}{lodg}[chapter]
\floatname{grafica}{Gráfica}
\newcommand{\listofgraficas}{\listof{grafica}{LISTA DE GRÁFICAS}}

% ------------------------------------------------------------- códigos ---
% La plantilla pide además una LISTA DE CÓDIGOS.
\RequirePackage{listings}
\renewcommand{\lstlistingname}{Código}
\renewcommand{\lstlistlistingname}{LISTA DE CÓDIGOS}
\lstset{
  basicstyle=\ttfamily\footnotesize,
  breaklines=true,
  frame=single,
  captionpos=b,
  showstringspaces=false,
  numbers=left,
  numberstyle=\tiny,
  inputencoding=utf8,
  extendedchars=true,
  literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
           {ñ}{{\~n}}1 {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1
           {Ú}{{\'U}}1 {Ñ}{{\~N}}1 {¿}{{?`}}1 {¡}{{!`}}1
}

% ------------------------------------------------------------ referencias ---
% La plantilla pide formato IEEE. Se usa biblatex+biber con estilo ieee.
% Overleaf lo trae; si se compila en local hace falta 'biber', no 'bibtex'.
\RequirePackage[backend=biber,style=ieee,sorting=none]{biblatex}

% ------------------------------------------------------------- hipervínculos ---
\RequirePackage[hidelinks]{hyperref}
\hypersetup{pdfencoding=auto}

% =====================================================================
%  Datos del trabajo. Se rellenan una vez en main.tex.
% =====================================================================
